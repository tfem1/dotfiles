#!/usr/bin/env bash
# CLI du projet. Les alias neutres (dots, wm) sont de simples liens vers ce
# script : l'aide affiche toujours le nom sous lequel on l'a appelé.
set -euo pipefail

root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
prog="$(basename "$0")"

usage() {
  cat <<EOF
Utilisation : $prog <commande> [options]

Commandes :
  generate      Génère tous les fichiers de thème depuis theme.toml
                  --dry-run          montre ce qui changerait, sans rien écrire
                  --only NOM[,NOM]   ne génère que ces cibles
                  --all              génère même si l'app n'est pas installée
  help          Affiche cette aide

Tes réglages : \${XDG_CONFIG_HOME:-~/.config}/tfem/theme.toml et config.json
Défauts :      $root
EOF
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$command" in
  generate) exec "$root/scripts/generate.sh" "$@" ;;
  help | -h | --help) usage ;;
  *)
    echo "$prog : commande inconnue '$command'" >&2
    usage >&2
    exit 64
    ;;
esac
