#!/usr/bin/env bash
# Project CLI. The neutral aliases (dots, wm) are plain links to this script:
# the help always shows the name it was called with.
set -euo pipefail

root="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
prog="$(basename "$0")"

usage() {
  cat <<EOF
Usage: $prog <command> [options]

Commands:
  generate      Render every theme file from theme.toml
                  --dry-run           show what would change, write nothing
                  --only NAME[,NAME]  render only these targets
                  --all               render even if the app is not installed
  screenshot    Take a screenshot: region|full [--edit]
  wallpapers    fetch [--category NAME]: download the collection
                list [--json]: list your wallpapers; set IMAGE: use one
                (a pony or forest wallpaper also brings its theme)
  icons         fetch: download the FairyWren icons (dark and light)
                folders COLOR: color of their folders (tfem generate sets it)
  settings      get: every setting as JSON; set KEY=VALUE...: change and apply
                (the Settings window, SUPER + H, uses it)
  display       list: screens and their modes; set NAME MODE: e.g.
                set DP-1 2560x1440@165.00; auto NAME: highest refresh rate
  sddm          install [NAME]: install and select a login screen (sudo)
                test [NAME]: show it in a window; NAME: welcome-panel, stacked-clock
  help          Show this help

Your settings: \${XDG_CONFIG_HOME:-~/.config}/tfem/theme.toml and config.json
Defaults:      $root
EOF
}

need_python() {
  if ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    echo "$prog: python 3.11 or newer is required" >&2
    exit 1
  fi
}

command="${1:-help}"
if [[ $# -gt 0 ]]; then shift; fi

case "$command" in
  generate) exec "$root/scripts/generate.sh" "$@" ;;
  screenshot) exec "$root/scripts/screenshot.sh" "$@" ;;
  wallpapers) need_python && exec python3 "$root/scripts/wallpapers.py" "$@" ;;
  icons) need_python && exec python3 "$root/scripts/icons.py" "$@" ;;
  sddm) need_python && exec python3 "$root/scripts/sddm.py" "$@" ;;
  settings) need_python && exec python3 "$root/scripts/settings.py" "$@" ;;
  display) need_python && exec python3 "$root/scripts/display.py" "$@" ;;
  help | -h | --help) usage ;;
  *)
    echo "$prog: unknown command '$command'" >&2
    usage >&2
    exit 64
    ;;
esac
