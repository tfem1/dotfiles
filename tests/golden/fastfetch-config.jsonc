// Generated from theme.toml (Moonlit): do not edit by hand,
// change a setting and run the generator again. The keys, frames and logo
// take the theme's colors. Layout from github.com/harilvfs/fastfetch
// (old-days branch), with the theme's colors instead of fixed ones.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        },
        "color": {
            "1": "38;2;95;208;192",
            "2": "38;2;131;213;201"
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "38;2;131;213;201"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "38;2;131;213;201"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "38;2;131;213;201"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "38;2;131;213;201"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "38;2;131;213;201"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "38;2;103;190;200"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "38;2;103;190;200"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "38;2;103;190;200"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "38;2;103;190;200"
        },
        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "38;2;103;190;200"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m┌────────────────────Uptime / Age / DT────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "38;2;95;208;192",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "38;2;95;208;192"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;127;103;177m└─────────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ],
    "display": {
        "color": {
            "keys": "38;2;95;208;192",
            "title": "38;2;95;208;192",
            "output": "38;2;216;209;229"
        },
        "separator": " "
    }
