// Niri config of this desktop: the same keys and the same shell as the
// Hyprland one. Colors, gaps, focus ring, rounded corners and cursor come
// from theme.kdl, written by `tfem generate` from theme.toml (do not edit
// that one; niri reloads it by itself). Picked in the installer (--wm niri);
// needs niri 25.11 or newer (include). Your own settings can go at the end.

include "theme.kdl"

input {
    keyboard {
        xkb {
            layout "us"
            options "grp:alt_shift_toggle"
        }
    }
    touchpad {
        tap
        natural-scroll
    }
}

// The terminal and the shell's launcher read TERMINAL; Qt apps take the
// theme colors from qt5ct / qt6ct.
environment {
    TERMINAL "kitty"
    QT_QPA_PLATFORMTHEME "qt5ct"
}

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

// Started once: clipboard history, idle (dim, lock, screen off, suspend) and
// the shell (bar, panels, notifications, wallpaper, lock screen). The shell
// gets ~/.local/bin (tfem) on its PATH.
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
spawn-at-startup "hypridle"
spawn-sh-at-startup "PATH=$HOME/.local/bin:$PATH qs -c desktop -n -d"

binds {
    // Apps
    Mod+Return { spawn "kitty"; }
    Mod+F { spawn "firefox"; }
    Mod+E { spawn "nautilus"; }

    // Windows
    Mod+Q repeat=false { close-window; }
    Mod+Alt+F { maximize-column; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Shift+Left  { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Up    { set-window-height "-10%"; }
    Mod+Shift+Down  { set-window-height "+10%"; }

    // Workspaces: keys 1 to 9, then 0 for workspace 10
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Shell panels; Mod+Tab is niri's own overview.
    Mod+Tab { toggle-overview; }
    Mod+D { spawn-sh "qs ipc -c desktop call launcher toggle"; }
    Mod+B { spawn-sh "qs ipc -c desktop call system toggle"; }
    Mod+M { spawn-sh "qs ipc -c desktop call music toggle"; }
    Mod+W { spawn-sh "qs ipc -c desktop call wallpaper toggle"; }
    Mod+S { spawn-sh "qs ipc -c desktop call calendar toggle"; }
    Mod+N { spawn-sh "qs ipc -c desktop call network toggle"; }
    Mod+V { spawn-sh "qs ipc -c desktop call volume toggle"; }
    Mod+C { spawn-sh "qs ipc -c desktop call clipboard toggle"; }
    Mod+H { spawn-sh "qs ipc -c desktop call settings toggle"; }
    Mod+G { spawn-sh "qs ipc -c desktop call gamemode toggle"; }
    Mod+Slash { spawn-sh "qs ipc -c desktop call cheatsheet toggle"; }
    Mod+A { spawn-sh "qs ipc -c desktop call bar toggleAutohide"; }
    Mod+R { spawn-sh "qs kill -c desktop; PATH=$HOME/.local/bin:$PATH qs -c desktop -n -d"; }
    Mod+Escape { spawn-sh "qs ipc -c desktop call power toggle"; }

    // Session: the shell's lock screen, swaylock when the shell is not running.
    Mod+L allow-when-locked=true { spawn-sh "qs ipc -c desktop call lock lock || swaylock"; }
    XF86PowerOff allow-when-locked=true { spawn-sh "qs ipc -c desktop call lock lock || swaylock"; }

    // Media
    Mod+Space allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%+ && qs ipc -c desktop call osd brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -e4 -n2 set 5%- && qs ipc -c desktop call osd brightness"; }

    // Screenshots (saved in ~/Pictures/Screenshots and copied)
    Print { spawn-sh "~/.local/bin/tfem screenshot region"; }
    Shift+Print { spawn-sh "~/.local/bin/tfem screenshot region --edit"; }
    Mod+Print { spawn-sh "~/.local/bin/tfem screenshot full"; }
    Mod+Shift+Print { spawn-sh "~/.local/bin/tfem screenshot full --edit"; }
    Ctrl+Shift+S { spawn-sh "~/.local/bin/tfem screenshot full"; }
    Mod+Shift+Escape { spawn-sh "~/.local/bin/tfem screenshot full"; }

    // Color picker: click a pixel, its #RRGGBB is copied.
    Mod+Shift+C { spawn-sh "~/.local/bin/tfem pick"; }

    // Screen recording (saved in ~/Videos/Screencasts): again to stop.
    Mod+Alt+R { spawn-sh "~/.local/bin/tfem record"; }
}
