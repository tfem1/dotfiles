# Generated from theme.toml: do not edit by hand,
# change a setting and run the generator again (settings changed in the
# qt6ct window are replaced, a copy of the old file is kept in the backups).

[Appearance]
style=Fusion
custom_palette=true
color_scheme_path={{ dirs.config }}/qt6ct/colors/theme.conf
icon_theme={{ icons.name }}
standard_dialogs=default

# QFont strings (family, size in points, then Qt's defaults), quoted so the
# commas stay in one value.
[Fonts]
fixed="{{ font.mono }},{{ font.mono_size }},-1,5,50,0,0,0,0,0"
general="{{ font.sans }},{{ font.size }},-1,5,50,0,0,0,0,0"
