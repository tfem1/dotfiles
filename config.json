{
  "schema": 1,
  "shell": {
    "name": "desktop"
  },
  "idle": {
    "dim": 5,
    "lock": 10,
    "screen_off": 11,
    "suspend": 30
  },
  "bar": {
    "position": "top",
    "transparent": false
  },
  "dock": {
    "enabled": true,
    "position": "bottom",
    "opacity": 0.85,
    "autohide": false,
    "pinned": "firefox,kitty,org.gnome.Nautilus"
  },
  "widgets": {
    "corner": "top-left",
    "clock": true,
    "audio": true,
    "media": true,
    "cpu": true,
    "gpu": true,
    "ram": true,
    "disk": true,
    "calendar": true
  }
}
